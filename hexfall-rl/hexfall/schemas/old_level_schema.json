{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hexfall-rl/level.schema.json",
  "title": "HexFall Level",
  "description": "JSON Schema for Hex Fall level files. See LEVEL_FORMAT.md for the full human-readable spec.",
  "type": "object",
  "required": ["meta", "field", "buffer", "reserve"],
  "additionalProperties": false,

  "properties": {

    "meta": {
      "type": "object",
      "required": ["id", "name", "version", "color_count"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique level identifier. Lowercase kebab-case recommended.",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "description": "Human-readable display name.",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "description": "Format version. Must be 1 for this schema.",
          "const": 1
        },
        "color_count": {
          "type": "integer",
          "description": "Number of distinct colors used in the level. Must match actual distinct color count across field slices and reserve buckets.",
          "minimum": 1
        },
        "notes": {
          "type": "string",
          "description": "Optional freeform notes. Not read by the simulator."
        }
      }
    },

    "field": {
      "type": "object",
      "required": ["stacks"],
      "additionalProperties": false,
      "properties": {
        "stacks": {
          "type": "array",
          "description": "List of non-empty hex stacks in odd-r offset coordinates.",
          "items": {
            "type": "object",
            "required": ["col", "row", "slices"],
            "additionalProperties": false,
            "properties": {
              "col": {
                "type": "integer",
                "minimum": 0,
                "description": "Column index (odd-r offset, 0-based, left-to-right)."
              },
              "row": {
                "type": "integer",
                "minimum": 0,
                "description": "Row index (odd-r offset, 0-based, top-to-bottom)."
              },
              "slices": {
                "type": "array",
                "description": "Slice colors, ordered top-to-bottom (index 0 = top slice = next consumed).",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },

    "buffer": {
      "type": "object",
      "required": ["slots", "bucket_capacity"],
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "integer",
          "description": "Number of buffer slots. Standard Hex Fall value is 5.",
          "minimum": 1
        },
        "bucket_capacity": {
          "type": "integer",
          "description": "Number of slices to fill one bucket. Default is 25.",
          "minimum": 1
        }
      }
    },

    "reserve": {
      "type": "object",
      "required": ["rows", "cols", "cells"],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "description": "Number of rows in the reserve grid.",
          "minimum": 1
        },
        "cols": {
          "type": "integer",
          "description": "Number of columns in the reserve grid.",
          "minimum": 1
        },
        "cells": {
          "type": "array",
          "description": "Occupied reserve cells. Cells not listed are implicitly empty.",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/plain_bucket_cell" },
              { "$ref": "#/definitions/question_bucket_cell" },
              { "$ref": "#/definitions/generator_cell" },
              { "$ref": "#/definitions/wall_cell" }
            ]
          }
        }
      }
    }

  },

  "definitions": {

    "cell_base": {
      "type": "object",
      "required": ["row", "col", "type"],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "description": "Row index within the reserve grid (0-based, top-to-bottom)."
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "description": "Column index within the reserve grid (0-based, left-to-right)."
        },
        "type": {
          "type": "string"
        }
      }
    },

    "plain_bucket_cell": {
      "allOf": [
        { "$ref": "#/definitions/cell_base" }
      ],
      "type": "object",
      "required": ["row", "col", "type", "color"],
      "additionalProperties": false,
      "properties": {
        "row":   { "type": "integer", "minimum": 0 },
        "col":   { "type": "integer", "minimum": 0 },
        "type":  { "type": "string", "const": "plain_bucket" },
        "color": {
          "type": "string",
          "minLength": 1,
          "description": "Bucket color. Visible to agent immediately."
        }
      }
    },

    "question_bucket_cell": {
      "allOf": [
        { "$ref": "#/definitions/cell_base" }
      ],
      "type": "object",
      "required": ["row", "col", "type", "color"],
      "additionalProperties": false,
      "properties": {
        "row":   { "type": "integer", "minimum": 0 },
        "col":   { "type": "integer", "minimum": 0 },
        "type":  { "type": "string", "const": "question_bucket" },
        "color": {
          "type": "string",
          "minLength": 1,
          "description": "True bucket color. Hidden from agent until bucket becomes reachable (HEXFALL_MDP_SPEC §4.3–4.4)."
        }
      }
    },

    "generator_cell": {
      "allOf": [
        { "$ref": "#/definitions/cell_base" }
      ],
      "type": "object",
      "required": ["row", "col", "type", "facing", "remaining", "queue"],
      "additionalProperties": false,
      "properties": {
        "row":  { "type": "integer", "minimum": 0 },
        "col":  { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "const": "generator" },
        "facing": {
          "type": "string",
          "enum": ["up", "down", "left", "right"],
          "description": "Direction the generator faces. The cell in this direction receives produced buckets."
        },
        "remaining": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of buckets still to be produced. Must equal queue.length. JSON Schema cannot enforce cross-field equality; the simulator loader must assert remaining == len(queue) at load time."
        },
        "queue": {
          "type": "array",
          "description": "Colors of buckets to be produced in order (index 0 = next). Hidden from agent; only remaining count and facing are observable.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },

    "wall_cell": {
      "allOf": [
        { "$ref": "#/definitions/cell_base" }
      ],
      "type": "object",
      "required": ["row", "col", "type"],
      "additionalProperties": false,
      "properties": {
        "row":  { "type": "integer", "minimum": 0 },
        "col":  { "type": "integer", "minimum": 0 },
        "type": { "type": "string", "const": "wall" }
      }
    }

  }
}
